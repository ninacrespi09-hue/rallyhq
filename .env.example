# Optional: enables real Claude-powered check-in analysis.
# Without it, the app falls back to a built-in rule-based engine.
ANTHROPIC_API_KEY=

# Secret used to sign auth session tokens. Change in production and keep stable
# across deploys so users stay signed in.
AUTH_SECRET=dev-secret-change-me-in-production

# Public URL of this app (used for email links + OAuth callbacks).
# Example production: https://rallyhq.onrender.com
APP_URL=http://localhost:3000

# Transactional email (Resend). Required for real verify / reset emails.
# Without it, links are logged to the server console (and shown in dev responses).
RESEND_API_KEY=
EMAIL_FROM=RallyHQ <onboarding@resend.dev>

# Set to 1 only for local demos if you want to skip mailbox verification.
SKIP_EMAIL_VERIFY=

# Google OAuth (Continue with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (Continue with Apple)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 private key; use \n for newlines if needed in one-line env vars.
APPLE_PRIVATE_KEY=
